{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:backoffice": "turbo run build --filter=backoffice",
    "build:editor": "turbo run build --filter=editor",
    "build:admin": "turbo run build --filter=admin",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis pgadmin",
    "db:migrate": "yarn workspace api prisma migrate deploy",
    "db:migrate:dev": "yarn workspace api prisma migrate dev",
    "db:seed": "yarn workspace api prisma db seed",
    "db:setup": "yarn workspace api run db:setup",
    "dev:commerce": "yarn workspace commerce dev",
    "db:commerce:ensure": "docker compose exec -T postgres psql -U cubecom -d postgres -v ON_ERROR_STOP=1 -f /docker-entrypoint-initdb.d/init.sql"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "expect": "30.4.1",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.10.9"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/commerce/**"
    ]
  },
  "resolutions": {
    "graphql": "16.11.0",
    "expect": "30.4.1",
    "jest-runtime": "30.4.1",
    "jest-util": "30.4.1",
    "jest-mock": "30.4.1",
    "dotenv": "17.4.1",
    "rxjs": "7.8.2",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/graphql": "13.4.4",
    "@nestjs/apollo": "13.4.4"
  }
}
