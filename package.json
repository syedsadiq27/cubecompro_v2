{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:backoffice": "turbo run build --filter=backoffice",
    "build:editor": "turbo run build --filter=editor",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis pgadmin",
    "db:migrate": "yarn workspace api prisma migrate deploy",
    "db:migrate:dev": "yarn workspace api prisma migrate dev",
    "db:seed": "yarn workspace api prisma db seed"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.10.9"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "graphql": "16.11.0"
  }
}
