{
  "name": "editor",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@repo/product-graph": "*",
    "@repo/store": "*",
    "@repo/ui": "*",
    "lucide-react": "^1.33.0",
    "next": "16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.3",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.0",
    "@repo/eslint-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "jest": "^30.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.5",
    "ts-jest": "^29.2.5",
    "typescript": "5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "strict": true,
            "skipLibCheck": true,
            "paths": {
              "@/*": [
                "./*"
              ]
            }
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@repo/product-graph$": "<rootDir>/../../packages/product-graph/src/index.ts",
      "^@repo/store$": "<rootDir>/../../packages/store/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testEnvironment": "node"
  }
}
