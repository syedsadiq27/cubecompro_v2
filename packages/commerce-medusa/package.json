{
  "name": "@repo/commerce-medusa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0 --ignore-pattern '**/*.integration.spec.ts'",
    "test": "jest",
    "test:integration": "COMMERCE_MEDUSA_INTEGRATION=1 jest --testPathPattern=integration"
  },
  "dependencies": {
    "@repo/commerce-core": "*",
    "@repo/product-graph": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.39.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.9.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "strict": true,
            "skipLibCheck": true
          }
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@repo/commerce-core$": "<rootDir>/../../commerce-core/src/index.ts",
      "^@repo/product-graph$": "<rootDir>/../../product-graph/src/index.ts"
    }
  }
}
