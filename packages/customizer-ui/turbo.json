{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:components"],
      "outputs": ["dist/**"]
    },
    "build:components": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "with": ["dev:components"]
    },
    "dev:components": {
      "cache": false,
      "persistent": true
    }
  }
}
