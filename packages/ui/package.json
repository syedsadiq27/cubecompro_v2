{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./cn": "./dist/lib/cn.js",
    "./button": "./dist/primitives/button.js",
    "./container": "./dist/primitives/container.js",
    "./section": "./dist/primitives/section.js",
    "./heading": "./dist/primitives/heading.js",
    "./card": "./dist/primitives/card.js",
    "./compare": "./dist/primitives/compare.js",
    "./faq-list": "./dist/primitives/faq-list.js",
    "./page-hero": "./dist/primitives/page-hero.js",
    "./stack": "./dist/primitives/stack.js",
    "./grid": "./dist/primitives/grid.js",
    "./frame": "./dist/primitives/frame.js",
    "./divided-list": "./dist/primitives/divided-list.js",
    "./label": "./dist/primitives/label.js",
    "./input": "./dist/primitives/input.js",
    "./field": "./dist/primitives/field.js",
    "./textarea": "./dist/primitives/textarea.js",
    "./select": "./dist/primitives/select.js",
    "./checkbox": "./dist/primitives/checkbox.js",
    "./switch": "./dist/primitives/switch.js",
    "./badge": "./dist/primitives/badge.js",
    "./status-pill": "./dist/primitives/status-pill.js",
    "./surface": "./dist/primitives/surface.js",
    "./panel": "./dist/primitives/panel.js",
    "./empty-state": "./dist/primitives/empty-state.js",
    "./spinner": "./dist/primitives/spinner.js",
    "./typography": "./dist/primitives/typography.js",
    "./tabs": "./dist/primitives/tabs.js",
    "./tooltip": "./dist/primitives/tooltip.js",
    "./stage": "./dist/brand/stage.js",
    "./wordmark": "./dist/brand/wordmark.js"
  },
  "license": "MIT",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/cli": "^4.1.5",
    "@types/react": "^19.1.0",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.5",
    "typescript": "5.9.2"
  }
}
