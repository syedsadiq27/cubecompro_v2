{
  "name": "@repo/product-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/graphql/client.d.ts",
      "default": "./dist/graphql/client.js"
    },
    "./operations": {
      "types": "./dist/graphql/operations.d.ts",
      "default": "./dist/graphql/operations.js"
    },
    "./types": {
      "types": "./dist/graph/types.d.ts",
      "default": "./dist/graph/types.js"
    },
    "./embed": {
      "types": "./dist/editor/embed.d.ts",
      "default": "./dist/editor/embed.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc && mkdir -p dist/materials && cp src/materials/material-properties.json dist/materials/material-properties.json",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "jest"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.39.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.9.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "strict": true,
            "skipLibCheck": true
          }
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
